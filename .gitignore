# =============================================================================
# tg_sales .gitignore
#
# This repository is PUBLIC. Never commit prospect lists, customer/contact
# data, sales metrics, private company resources, credentials, or local
# databases. Synthetic test fixtures under tests/fixtures/ are re-included at
# the bottom of this file and must remain synthetic and clearly labeled.
# =============================================================================

# -----------------------------------------------------------------------------
# Internal development planning files (local only, never published)
# -----------------------------------------------------------------------------
TASK_*.md
TASKS_*.md
docs/IMPLEMENTATION_STATUS.md
docs/internal/

# Portable runtimes downloaded by setup (PostgreSQL binaries, local clusters)
/runtime/
/pgdata/
/postgres_data/

# Local AI-assistant / agent workspace configuration
.claude/
.cursor/
CLAUDE.local.md

# -----------------------------------------------------------------------------
# Local CRM databases and SQLite side files
# -----------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm

# -----------------------------------------------------------------------------
# Business data: imported prospect lists, contacts, exports, reports
# -----------------------------------------------------------------------------
# Spreadsheet and tabular data files (prospect lists, contact exports, chart
# data). Synthetic fixtures are re-included at the end of this file.
*.csv
*.tsv
*.xlsx
*.xlsm
*.xlsb
*.xls
*.ods
*.jsonl
*.vcf

# Generated reports
*.pdf
tg_sales_report_*

# Local data directories (anchored to the repository root so that source
# packages such as src/tg_sales/reports/ and src/tg_sales/sync/ are NOT ignored)
/data/
/imports/
/import/
/exports/
/export/
/reports/
/prospects/
/leads/
/contacts/
/customers/
/user_data/
/tg_sales_data/
/portable_data/
/attachments/
/cache/

# Offline synchronization packages
tg_sales_sync_*.zip
/sync_packages/
/sync_exports/
/sync_imports/

# Dashboard snapshots and screenshots of real data
# (synthetic documentation screenshots belong in docs/screenshots/)
dashboard_snapshot_*.png
/snapshots/
/screenshots/
Screenshot*.png
Screen Shot*.png

# Local backups
/backups/
/backup/
*.bak
*.backup
*.db.bak
*.sqlite.bak

# Private company resources (data room, internal documents)
/private/
/private_resources/
/resources_private/
/data_room/
/dataroom/
/internal/
/confidential/

